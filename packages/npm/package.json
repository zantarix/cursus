{
	"name": "@zantarix/cursus",
	"version": "0.2.2",
	"publishConfig": {
		"provenance": true
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"description": "Release management with style",
	"homepage": "https://github.com/zantarix/cursus#readme",
	"bin": {
		"cursus": "bin/cursus"
	},
	"type": "module",
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf bin",
		"test": "eslint src",
		"prepare": "tsc",
		"postinstall": "node --input-type=module --eval \"import{existsSync}from'node:fs';if(!existsSync('./src'))await import('./bin/download-binary.js')\""
	},
	"bugs": {
		"url": "https://github.com/zantarix/cursus/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zantarix/cursus.git"
	},
	"license": "MPL-2.0",
	"author": "Matthew Scharley <github@zantarix.com>",
	"devDependencies": {
		"@mscharley/eslint-config": "4.2.23",
		"@types/node": "24.12.2",
		"typescript": "5.9.3"
	}
}
