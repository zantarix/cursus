{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "rust@zantarix": true,
    "base@zantarix": true
  },
  "extraKnownMarketplaces": {
    "zantarix": {
      "source": {
        "source": "github",
        "repo": "zantarix/claude-code"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/secrets/**)"
    ]
  }
}
